# Base de données Turso (production). Laisser vide en local pour utiliser
# le repli automatique sur un fichier SQLite local (./data/veypri.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Stockage des photos (production). Fourni automatiquement par Vercel une
# fois un store Vercel Blob lié au projet (nom de variable "BLOB2" car le
# store est public, pour le distinguer de l'ancien store privé). Laisser
# vide en local pour écrire les photos sur disque (./uploads), servies par
# /api/uploads/[filename].
BLOB2_READ_WRITE_TOKEN=

# Mot de passe de la page /admin (file de modération + signalements
# suspects), protégée par Basic Auth. Obligatoire : sans cette variable,
# /admin répond 503 (fermé par défaut plutôt qu'ouvert par erreur).
ADMIN_PASSWORD=

# CAPTCHA anti-bot (Cloudflare Turnstile, gratuit). Laisser vide en local :
# le CAPTCHA ne s'affiche pas et la vérification serveur est court-circuitée
# tant que TURNSTILE_SECRET_KEY est absent. Clés à créer sur
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

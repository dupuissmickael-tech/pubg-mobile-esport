# PostgreSQL connection string (Neon recommended, Supabase compatible).
# Without it the site runs in demo mode with built-in sample data.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Identifiable User-Agent required by Liquipedia API terms of use.
# Format: AppName/Version (contact email or URL)
LIQUIPEDIA_USER_AGENT="PubgMobileEsportHub/1.0 (you@example.com)"

# Optional LPDB API key if you have been granted access by Liquipedia.
LIQUIPEDIA_API_KEY=

# Shared secret checked by /api/cron/* routes (set the same value in Vercel).
CRON_SECRET=change-me

# Token protecting the /admin page and /api/admin/* routes.
ADMIN_TOKEN=change-me-too

# Canonical site URL, used for RSS, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
